<import name="btn-hard" src="../../common/ui/btn-hard.ux"></import>
<import name="dots" src="../../common/ui/dots.ux"></import>

<template>
  <stack class="page">
    <!-- HUD：左当前关卡标签（粉阴影），右计时（黄阴影） -->
    <div class="abs hud-shadow" style="left: 11px; top: 61px; background-color: #ff5b8d; width: 80px"></div>
    <div class="abs hud lv" style="left: 8px; top: 57px">
      <text class="hud-text lv-text">{{ levelName }}</text>
    </div>
    <div class="abs hud-shadow" style="left: 102px; top: 61px; background-color: #ffd323; width: 86px"></div>
    <div class="abs hud timer" style="left: 98px; top: 57px">
      <text class="hud-text timer-text">{{ timeText }}</text>
    </div>

    <!-- 迷宫板：阴影 + 板体 -->
    <div class="abs board-shadow" style="left: {{ shadowLeft }}px; top: 105px; width: {{ boardWidth }}px; height: {{ boardHeight }}px"></div>
    <div class="abs board" style="left: {{ boardLeft }}px; top: 100px; width: {{ boardWidth }}px; height: {{ boardHeight }}px"></div>

    <!-- 板内区域：墙体静态；球以 25Hz 独立提交变换，物理保持 50Hz -->
    <stack class="abs inner" style="left: {{ boardLeft }}px; top: 100px; width: {{ boardWidth }}px; height: {{ boardHeight }}px">
      <div class="abs goal" style="left: {{ goalLeft }}px; top: {{ goalTop }}px; width: {{ cellPx }}px; height: {{ cellPx }}px"></div>
      <div class="abs wall" for="{{ walls }}" style="left: {{ $item.l }}px; top: {{ $item.t }}px; width: {{ $item.w }}px; height: {{ $item.h }}px"></div>
      <div class="abs ball {{ ballClass }}" style="{{ ballStyle }}"></div>
    </stack>

    <div if="{{ loading }}" class="abs loading-shadow"></div>
    <div if="{{ loading }}" class="abs loading-card">
      <text class="loading-text">正在准备关卡</text>
    </div>

    <div class="abs" style="left: 35px; top: 395px" @click="onRestart">
      <btn-hard label="重来" width="122" height="44" bg="#FFD323" shadow="#FF5B8D" font-size="18"></btn-hard>
    </div>
    <div class="abs" style="left: 0px; top: 446px"><dots gap="14"></dots></div>
  </stack>
</template>

<script>
import router from '@system.router'
import sensor from '@system.sensor'
import Physics from '../../common/physics.js'
import { OFFICIAL, buildOfficial } from '../../common/levels.js'
import CustomLevels from '../../common/custom-levels.js'
import { returnToPage } from '../../common/navigation.js'

/** 加速度低通滤波系数 */
const LPF = 0.35
/** 宽度上限保留左右各 4px；高度优先避开现有重来按钮。 */
const INNER_W = 184
/** 按钮 top 395 - 迷宫 top 100 - 阴影 5 - 间隔 4。 */
const INNER_H = 286

function customLevelTitle(index) {
  const number = index + 1
  return '自定义' + (number < 10 ? '0' + number : String(number))
}

export default {
  protected: {
    pack: 'official',
    index: 0
  },
  private: {
    loading: false,
    levelName: 'LV 1',
    timeText: '00.0',
    cellPx: 20,
    boardWidth: 0,
    boardHeight: 0,
    boardLeft: 96,
    shadowLeft: 101,
    goalLeft: 0,
    goalTop: 0,
    walls: [],
    ballStyle: { transform: '{"translateX":"0px","translateY":"0px"}' },
    ballClass: 'ball-size-11',
    ballSize: 11
  },

  onInit() {
    const parsedIndex = parseInt(this.index, 10)
    const requestedIndex = isNaN(parsedIndex) ? 0 : parsedIndex
    if (this.pack === 'official') {
      this.index = Math.max(0, Math.min(OFFICIAL.length - 1, requestedIndex))
    } else if (this.pack === 'custom') {
      this.index = Math.max(0, Math.min(CustomLevels.MAX_CUSTOM_LEVELS - 1, requestedIndex))
    } else {
      this.onBackPress()
      return
    }
    if (this.pack === 'custom') this.levelName = customLevelTitle(this.index)
    // 非响应式运行时数据挂在 this 上，避免触发视图刷新
    this.level = null
    this.collisionIndex = null
    this.state = null
    this.ax = 0
    this.ay = 0
    this.elapsed = 0
    this.accumulator = 0
    this.lastTick = Date.now()
    this.finished = false
    this.timer = null
    this.renderTimer = null
    this.offX = 0
    this.offY = 0
    this.ready = false
    this.disposed = false
    if (this.pack === 'official') {
      this.setupLevel(buildOfficial(this.index))
    } else {
      this.startPreparation()
    }
  },

  startPreparation() {
    if (this.pack !== 'custom' || this.ready || this.disposed || this.prepareSession) return
    const session = {}
    this.prepareSession = session
    const started = Date.now()
    const current = () => this.prepareSession === session && !this.disposed
    this.loadingTimer = setTimeout(() => {
      if (!current()) return
      this.loadingTimer = null
      if (!this.ready && !this.loading) this.loading = true
    }, 80)
    // 阶段之间让出事件循环；单个同步阶段超时后也有机会绘制兜底提示。
    const schedule = (work) => {
      if (!current()) return
      if (Date.now() - started >= 80 && !this.loading) this.loading = true
      this.prepareTimer = setTimeout(() => {
        if (!current()) return
        this.prepareTimer = null
        try { work() } catch (error) {
          console.log('[maze] 准备关卡失败: ' + error)
          this.onBackPress()
        }
      }, 0)
    }
    this.$app.$def.slotStore.ready.then((ready) => {
      if (!current()) return
      if (ready === false) {
        this.onBackPress()
        return
      }
      schedule(() => {
        const level = this.$app.$def.slotStore.getLevel(this.index)
        if (!level) { this.onBackPress(); return }
        schedule(() => {
          Physics.getCollisionIndex(level)
          schedule(() => this.setupLevel(level))
        })
      })
    }).catch(() => {
      if (current()) this.onBackPress()
    })
  },

  stopPreparation() {
    this.prepareSession = null
    if (this.prepareTimer) clearTimeout(this.prepareTimer)
    if (this.loadingTimer) clearTimeout(this.loadingTimer)
    this.prepareTimer = null
    this.loadingTimer = null
    if (this.loading) this.loading = false
  },

  /** 载入关卡：计算尺寸、生成静态墙段、放置球 */
  setupLevel(level) {
    this.level = level
    this.collisionIndex = this.pack === 'custom' ? Physics.getCollisionIndex(level) : Physics.buildCollisionIndex(level)
    if (this.pack !== 'custom') this.levelName = level.name || 'LV ' + (this.index + 1)
    const cols = level.cols
    const rows = level.rows
    const cellPx = Math.min(INNER_W / cols, INNER_H / rows)
    this.cellPx = cellPx
    this.boardWidth = cols * cellPx
    this.boardHeight = rows * cellPx
    this.boardLeft = (192 - this.boardWidth) / 2
    this.shadowLeft = this.boardLeft + 5
    this.offX = 0
    this.offY = 0
    const thick = Math.min(4, Math.max(2, Math.round(cellPx * 0.2)))
    const half = thick / 2

    const walls = []
    const h = level.render.h
    const v = level.render.v
    for (let i = 0; i < h.length; i += 3) {
      const x = h[i]
      const y = h[i + 1]
      const len = h[i + 2]
      const isTop = x === 0 && y === 0 && len === cols
      const isBottom = x === 0 && y === rows && len === cols
      // 上下外围墙完整内收，并覆盖四角；内部墙仍按原网格坐标绘制。
      if (isTop || isBottom) {
        walls.push({ l: 0, t: isTop ? 0 : this.boardHeight - thick, w: this.boardWidth, h: thick })
        continue
      }
      walls.push({
        l: this.offX + h[i] * cellPx - half,
        t: this.offY + h[i + 1] * cellPx - half,
        w: h[i + 2] * cellPx + thick,
        h: thick
      })
    }
    for (let i = 0; i < v.length; i += 3) {
      const x = v[i]
      const y = v[i + 1]
      const len = v[i + 2]
      const isLeft = x === 0 && y === 0 && len === rows
      const isRight = x === cols && y === 0 && len === rows
      // 左右外围墙完整落在区域内部，两端与上下墙相接而不重复覆盖四角。
      if (isLeft || isRight) {
        walls.push({ l: isLeft ? 0 : this.boardWidth - thick, t: thick, w: thick, h: this.boardHeight - 2 * thick })
        continue
      }
      walls.push({
        l: this.offX + v[i] * cellPx - half,
        t: this.offY + v[i + 1] * cellPx - half,
        w: thick,
        h: v[i + 2] * cellPx + thick
      })
    }
    this.walls = walls

    this.goalLeft = this.offX + (level.goal % cols) * cellPx
    this.goalTop = this.offY + Math.floor(level.goal / cols) * cellPx

    const ballSize = Math.round(0.56 * cellPx)
    this.ballSize = ballSize
    this.ballClass = 'ball-size-' + ballSize

    this.ready = true
    this.resetRuntime()
    this.stopPreparation()
  },

  /** 只重置球位置/速度/计时/finished，不触碰传感器订阅与定时器 */
  resetRuntime() {
    if (!this.level) return
    this.state = Physics.createState(this.level)
    this.elapsed = 0
    this.accumulator = 0
    this.lastTick = Date.now()
    this.finished = false
    this.timeText = '00.0'
    this.lastHudDraw = this.lastTick
    this.syncBall()
  },

  /** 仅显示循环、重来和通关提交变换；基础位置与尺寸保持固定。 */
  syncBall() {
    const cellPx = this.cellPx
    const r = this.ballSize / 2
    const left = Math.round(this.offX + this.state.x * cellPx - r)
    const top = Math.round(this.offY + this.state.y * cellPx - r)
    if (left === this.ballLeft && top === this.ballTop) return
    // Toolkit 2.x 的对象样式使用序列化变换值，避免重新解析整段 CSS。
    if (left !== this.ballLeft) this.ballLeft = left
    if (top !== this.ballTop) this.ballTop = top
    this.ballStyle = { transform: JSON.stringify({ translateX: left + 'px', translateY: top + 'px' }) }
  },

  onShow() {
    if (this.disposed || this.finished || this.running) return
    this.startPreparation()
    this.running = true
    // 每次恢复建立独立会话，隔离上次订阅/定时器的迟到回调。
    const session = {}
    this.loopSession = session
    this.ax = 0
    this.ay = 0
    const self = this
    try {
      sensor.subscribeAccelerometer({
        interval: 'game',
        callback(ret) {
          if (!self.running || self.loopSession !== session) return
          if (!ret || typeof ret.x !== 'number' || typeof ret.y !== 'number' || !isFinite(ret.x) || !isFinite(ret.y)) return
          self.ax += (ret.x - self.ax) * LPF
          self.ay += (ret.y - self.ay) * LPF
        },
        fail(data, code) {
          console.log('[maze] 加速度订阅失败 ' + code)
        }
      })
    } catch (e) {
      console.log('[maze] sensor 不可用: ' + e)
    }
    if (this.timer) clearInterval(this.timer)
    this.lastTick = Date.now()
    this.lastHudDraw = this.lastTick
    this.timer = setInterval(() => {
      if (this.loopSession === session) this.tick()
    }, 20)
    this.renderTimer = setInterval(() => {
      if (this.loopSession === session) this.renderFrame()
    }, 40)
  },

  onHide() {
    this.stopPreparation()
    this.stopLoop()
  },

  onDestroy() {
    this.disposed = true
    this.stopPreparation()
    this.stopLoop()
  },

  onBackPress() {
    if (this.disposed) return true
    this.disposed = true
    this.stopPreparation()
    this.stopLoop()
    returnToPage('/pages/levels')
    return true
  },

  stopLoop() {
    if (!this.running) return
    this.running = false
    this.loopSession = null
    try {
      sensor.unsubscribeAccelerometer()
    } catch (e) {}
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = null
    }
    if (this.renderTimer) {
      clearInterval(this.renderTimer)
      this.renderTimer = null
    }
  },

  /** 用真实前台时间累计，以 20ms 固定步长推进物理。 */
  tick() {
    if (!this.running || !this.ready || this.finished || this.disposed) return
    const now = Date.now()
    const delta = Math.max(0, now - this.lastTick)
    this.lastTick = now
    this.elapsed += delta
    this.accumulator += delta
    const lv = this.level
    const tx = Physics.AXIS_SIGN.x * Physics.normalizeTilt(this.ax)
    const ty = Physics.AXIS_SIGN.y * Physics.normalizeTilt(this.ay)
    const stepMs = Physics.CONST.DT * 1000
    let won = false
    let steps = 0
    while (steps < 3 && this.accumulator + 1e-7 >= stepMs) {
      this.accumulator = Math.max(0, this.accumulator - stepMs)
      Physics.step(this.state, this.collisionIndex, lv.cols, lv.rows, tx, ty, Physics.CONST.DT)
      steps++
      if (Physics.reachedGoal(this.state, lv)) {
        won = true
        break
      }
    }
    // 超出三步的积压直接丢弃，仅保留不足一步的余量。
    if (this.accumulator >= stepMs) this.accumulator %= stepMs
    if (won) {
      this.syncBall()
      this.syncHud()
      this.onWin()
    }
  },

  /** 显示循环不补帧，只读取最新状态；HUD 保留时间余量，避免节流漂移。 */
  renderFrame() {
    if (!this.running || !this.ready || this.finished || this.disposed) return
    this.syncBall()
    const now = Date.now()
    const hudDelta = now - this.lastHudDraw
    if (hudDelta >= 200) {
      this.syncHud()
      this.lastHudDraw += Math.floor(hudDelta / 200) * 200
    }
  },

  syncHud() {
    const t = Math.floor(this.elapsed / 100)
    const s = Math.floor(t / 10)
    const timeText = (s < 10 ? '0' + s : '' + s) + '.' + (t % 10)
    if (timeText !== this.timeText) this.timeText = timeText
  },

  onWin() {
    this.finished = true
    this.stopLoop()
    if (this.pack === 'official') this.$app.$def.markCleared(this.index)
    this.$app.$def.feedback()
    router.replace({
      uri: '/pages/complete',
      params: { pack: this.pack, index: String(this.index), time: this.timeText }
    })
  },

  onRestart() {
    this.resetRuntime()
  }
}
</script>

<style>
.page {
  width: 192px;
  height: 490px;
  background-color: #f3efe7;
}
.abs {
  position: absolute;
}
.loading-shadow {
  left: 22px;
  top: 225px;
  width: 156px;
  height: 44px;
  background-color: #ff5b8d;
}
.loading-card {
  left: 18px;
  top: 221px;
  width: 156px;
  height: 44px;
  border: 3px solid #111111;
  background-color: #ffd323;
  justify-content: center;
  align-items: center;
}
.loading-text {
  font-size: 16px;
  color: #111111;
  font-weight: bold;
}
.hud-shadow {
  height: 34px;
}
.hud {
  height: 34px;
  border: 3px solid #111111;
  justify-content: center;
  align-items: center;
  padding: 0 8px;
}
.lv {
  width: 80px;
  background-color: #111111;
  padding: 0 4px;
}
.timer {
  width: 86px;
  background-color: #ffffff;
}
.hud-text {
  font-size: 18px;
  font-weight: 900;
  text-align: center;
}
.lv-text {
  width: 66px;
  height: 16px;
  color: #ffffff;
  font-size: 12px;
  font-weight: bold;
  lines: 1;
  line-height: 16px;
  text-overflow: clip;
}
.timer-text {
  color: #111111;
}
.board-shadow {
  background-color: #ff5b8d;
}
.board {
  background-color: #ffffff;
}
.goal {
  background-color: #FF5B8D;
}
.wall {
  background-color: #111111;
}
.ball {
  left: 0px;
  top: 0px;
  background-color: #ffd323;
  border-style: solid;
  border-color: #111111;
}
/* 当前关卡范围 7..11 列、13..20 行，对应球直径 8..12px。 */
.ball-size-8 {
  width: 8px;
  height: 8px;
  border-radius: 4px;
  border-width: 2px;
}
.ball-size-9 {
  width: 9px;
  height: 9px;
  border-radius: 5px;
  border-width: 2px;
}
.ball-size-10 {
  width: 10px;
  height: 10px;
  border-radius: 5px;
  border-width: 3px;
}
.ball-size-11 {
  width: 11px;
  height: 11px;
  border-radius: 6px;
  border-width: 3px;
}
.ball-size-12 {
  width: 12px;
  height: 12px;
  border-radius: 6px;
  border-width: 3px;
}
</style>
