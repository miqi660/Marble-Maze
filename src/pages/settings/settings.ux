  width: 106px;
  height: 8px;
  background-color: #ff5b8d;
}
.card-shadow {
  width: 160px;
  height: 100px;
  background-color: #ff5b8d;
}
.card {
  width: 160px;
  height: 100px;
  background-color: #ffffff;
  border: 3px solid #111111;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 12px;
}
.card-col {
  flex-direction: column;
}
.card-title {
  font-size: 18px;
  font-weight: 900;
  color: #111111;
}
.card-sub {
  font-size: 12px;
  color: #66615b;
  margin-top: 4px;
}
.sw {
  width: 44px;
  height: 26px;
  thumb-color: #111111;
  track-color: #ffd323;
}
.brightness-shadow {
  width: 160px;
  height: 104px;
  background-color: #ffd323;
}
.brightness-card {
  width: 160px;
  height: 104px;
  border: 3px solid #111111;
  background-color: #ffffff;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.brightness-controls {
  width: 144px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.brightness-button {
  width: 68px;
  height: 56px;
  justify-content: center;
  align-items: center;
  background-color: #ffd323;
  border: 2px solid #111111;
}
.brightness-symbol {
  font-size: 26px;
  text-align: center;
  color: #111111;
}
.container {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
}
/* 内容保留 192×490 坐标；外层负责满屏背景和裁切。 */
.design-stage {
  position: absolute;
  left: 0px;
  top: -25px;
  width: 192px;
  height: 490px;
}
/* Band 10：212×520，DPR=2；按高度等比适配，避免按宽度放大后超高。 */
@media (width: 106) and (height: 260) {
  .design-stage {
    left: 3.733539px;
    transform: scale(0.96110897);
    transform-origin: 0px 0px;
  }
}
</style>
