<import name="btn-hard" src="../../common/ui/btn-hard.ux"></import>

<template>
  <stack class="page">
    <div class="abs" style="left: 0px; top: 60px">
      <text class="title">设置</text>
    </div>
    <div class="abs bar" style="left: 43px; top: 106px"></div>

    <!-- 震动开关卡 -->
    <div class="abs card-shadow" style="left: 20px; top: 164px"></div>
    <div class="abs card" style="left: 16px; top: 160px">
      <div class="card-col">
        <text class="card-title">按钮震动</text>
        <text class="card-sub">{{ vibrateOn ? '已开启' : '已关闭' }}</text>
      </div>
      <switch class="sw" checked="{{ vibrateOn }}" @change="onToggle"></switch>
    </div>

    <div class="abs" style="left: 24px; top: 300px" @click="goBack">
      <btn-hard label="返回" width="144" height="44" bg="#FFFFFF" shadow="#FF5B8D" font-size="18"></btn-hard>
    </div>
  </stack>
</template>

<script>
import router from '@system.router'

export default {
  private: {
    vibrateOn: true
  },
  onInit() {
    this.vibrateOn = this.$app.$def.vibrateOn
  },
  onToggle(e) {
    this.vibrateOn = !!e.checked
    this.$app.$def.setVibrate(this.vibrateOn)
    this.$app.$def.feedback()
  },
  goBack() {
    router.back()
  }
}
</script>

