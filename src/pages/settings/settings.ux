.page {
  width: 192px;
  height: 490px;
  background-color: #f3efe7;
}
.abs {
  position: absolute;
}
.title {
  width: 192px;
  font-size: 33px;
  font-weight: 900;
  color: #111111;
  text-align: center;
}
.bar {
  width: 106px;
  height: 8px;
  background-color: #ff5b8d;
}
.card-shadow {
  width: 160px;
  height: 100px;
  background-color: #ff5b8d;
}
.card {
  width: 160px;
  height: 100px;
  background-color: #ffffff;
  border: 3px solid #111111;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 12px;
}
.card-col {
  flex-direction: column;
}
.card-title {
  font-size: 18px;
  font-weight: 900;
  color: #111111;
}
.card-sub {
  font-size: 12px;
  color: #66615b;
  margin-top: 4px;
}
.sw {
  width: 44px;
  height: 26px;
  thumb-color: #111111;
  track-color: #ffd323;
}
</style>
