<import name="btn-hard" src="../../common/ui/btn-hard.ux"></import>
<template>
  <stack class="page container">
    <stack class="design-stage">
      <stack class="settings-paper">
        <text class="abs title" style="left: 28px; top: 18px">设置</text>
        <div class="abs card-shadow" style="left: 35px; top: 97px; height: 108px; background-color: #FF2E78"></div>
        <stack class="abs card" style="left: 28px; top: 89px; height: 108px">
          <text class="abs card-title" style="left: 18px; top: 25px">按钮震动</text>
          <text class="abs card-sub" style="left: 18px; top: 55px">{{ vibrateOn ? '已开启' : '已关闭' }}</text>
          <stack class="abs toggle" style="left: 182px; top: 35px; background-color: {{ vibrateOn ? '#FFD522' : '#A8A8A8' }}" @click="toggleVibrate">
            <div class="abs thumb" style="left: {{ vibrateOn ? 38 : 4 }}px; top: 4px"></div>
          </stack>
        </stack>
        <div class="abs card-shadow" style="left: 35px; top: 223px; height: 157px; background-color: #FFD522"></div>
        <stack class="abs card" style="left: 28px; top: 215px; height: 157px">
          <text class="abs brightness-title" style="left: 16px; top: 14px">应用亮度 {{ brightnessPercent }}%</text>
          <div class="abs" style="left: 16px; top: 58px" @click="dim"><btn-hard label="−" width="100" height="74" font-size="36" shadow="#A8A8A8" shadow-x="3" shadow-y="3" feedback-on-click="{{ false }}"></btn-hard></div>
          <div class="abs divider" style="left: 134px; top: 73px"></div>
          <div class="abs" style="left: 156px; top: 58px" @click="brighten"><btn-hard label="+" width="100" height="74" font-size="36" shadow="#A8A8A8" shadow-x="3" shadow-y="3" feedback-on-click="{{ false }}"></btn-hard></div>
        </stack>
        <div class="abs" style="left: 28px; top: 392px" @click="goBack"><btn-hard label="返回" width="272" height="55" bg="#F4F5F5" shadow="#FFD522" shadow-x="7" shadow-y="8" font-size="26"></btn-hard></div>
      </stack>
    </stack>
  </stack>
</template>

<script>
import router from '@system.router'

export default {
  private: {
    vibrateOn: true,
    brightnessPercent: 50
  },
  onInit() {
    this.vibrateOn = this.$app.$def.vibrateOn
  },
  onShow() {
    this.active = true
    const app = this.$app.$def
    this.vibrateOn = app.vibrateOn
    this.brightnessPercent = app.getBrightness()
    app.brightnessReady.then(() => {
      if (this.active) this.brightnessPercent = app.getBrightness()
    })
    app.vibrateReady.then(() => {
      if (this.active) this.vibrateOn = app.vibrateOn
    })
  },
  onHide() {
    this.active = false
  },
  onDestroy() {
    this.onHide()
  },
  dim() { this.adjustBrightness(-10) },
  brighten() { this.adjustBrightness(10) },
  adjustBrightness(delta) {
    if (!this.active) return
    const app = this.$app.$def
    if (typeof delta !== 'number' || !isFinite(delta)) return
    const percent = Math.max(10, Math.min(100, app.getBrightness() + delta))
    if (percent === this.brightnessPercent) return
    this.brightnessPercent = percent
    app.setBrightness(percent)
    app.feedback()
  },
  toggleVibrate() {
    this.onToggle({ checked: !this.vibrateOn })
  },
  onToggle(e) {
    this.vibrateOn = !!e.checked
    if (this.vibrateOn === this.$app.$def.vibrateOn) return
    this.$app.$def.setVibrate(this.vibrateOn)
    this.$app.$def.feedback()
  },
  goBack() {
    router.back()
  }
}
</script>

<style>
.page { width: 100%; height: 100%; background-color: #FAF8F3; }
.container { position: absolute; left: 0px; top: 0px; overflow: hidden; }
.design-stage { position: absolute; left: 0px; top: 0px; width: 336px; height: 480px; }

.abs { position: absolute; }
.settings-paper { width: 336px; height: 480px; background-color: #FAF8F3; }
.title { width: 280px; height: 54px; font-size: 32px; font-weight: bold; color: #111111; text-align: center; }
.card-shadow, .card { width: 272px; }
.card { border: 3px solid #111111; background-color: #F4F5F5; }
.card-title { font-size: 20px; font-weight: bold; color: #111111; }
.card-sub { font-size: 16px; font-weight: bold; color: #5E5E5E; }
.toggle { width: 72px; height: 38px; border-radius: 19px; }
.thumb { width: 30px; height: 30px; border-radius: 15px; background-color: #090909; }
.brightness-title { width: 240px; height: 28px; font-size: 20px; font-weight: bold; color: #111111; text-align: center; }
.divider { width: 3px; height: 44px; background-color: #111111; }
</style>
