<import name="btn-hard" src="../../common/ui/btn-hard.ux"></import>

<template>
  <stack class="page container">
    <stack class="design-stage">
      <div class="abs" style="left: 0px; top: 60px">
        <text class="title">设置</text>
      </div>
      <div class="abs bar" style="left: 43px; top: 106px"></div>

      <!-- 震动开关卡 -->
      <div class="abs card-shadow" style="left: 20px; top: 144px"></div>
      <div class="abs card" style="left: 16px; top: 140px">
        <div class="card-col">
          <text class="card-title">按钮震动</text>
          <text class="card-sub">{{ vibrateOn ? '已开启' : '已关闭' }}</text>
        </div>
        <switch class="sw" checked="{{ vibrateOn }}" @change="onToggle"></switch>
      </div>

      <div class="abs brightness-shadow" style="left: 20px; top: 264px"></div>
      <div class="abs brightness-card" style="left: 16px; top: 260px">
        <text class="card-title">应用亮度 {{ brightnessPercent }}%</text>
        <div class="brightness-controls">
          <div class="brightness-button" @click="dim"><text class="brightness-symbol">−</text></div>
          <div class="brightness-button" @click="brighten"><text class="brightness-symbol">+</text></div>
        </div>
      </div>

      <div class="abs" style="left: 24px; top: 384px" @click="goBack">
        <btn-hard label="返回" width="144" height="44" bg="#FFFFFF" shadow="#FF5B8D" font-size="18"></btn-hard>
      </div>
    </stack>
  </stack>
</template>

<script>
import router from '@system.router'

export default {
  private: {
    vibrateOn: true,
    brightnessPercent: 50
  },
  onInit() {
    this.vibrateOn = this.$app.$def.vibrateOn
  },
  onShow() {
    this.active = true
    const app = this.$app.$def
    this.vibrateOn = app.vibrateOn
    this.brightnessPercent = app.getBrightness()
    app.brightnessReady.then(() => {
      if (this.active) this.brightnessPercent = app.getBrightness()
    })
    app.vibrateReady.then(() => {
      if (this.active) this.vibrateOn = app.vibrateOn
    })
  },
  onHide() {
    this.active = false
  },
  onDestroy() {
    this.onHide()
  },
  dim() { this.adjustBrightness(-10) },
  brighten() { this.adjustBrightness(10) },
  adjustBrightness(delta) {
    if (!this.active) return
    const app = this.$app.$def
    if (typeof delta !== 'number' || !isFinite(delta)) return
    const percent = Math.max(10, Math.min(100, app.getBrightness() + delta))
    if (percent === this.brightnessPercent) return
    this.brightnessPercent = percent
    app.setBrightness(percent)
    app.feedback()
  },
  onToggle(e) {
    this.vibrateOn = !!e.checked
    if (this.vibrateOn === this.$app.$def.vibrateOn) return
    this.$app.$def.setVibrate(this.vibrateOn)
    this.$app.$def.feedback()
  },
  goBack() {
    router.back()
  }
}
</script>

