<import name="eyebrow" src="../../common/ui/eyebrow.ux"></import>

<template>
  <stack class="page" @touchstart="onTouchStart" @touchend="onTouchEnd">
    <!-- 页 1：Official -->
    <stack if="{{ pageIndex === 0 }}" class="page">
      <div class="abs" style="left: 63px; top: 48px">
        <eyebrow label="LEVELS" width="66" height="24"></eyebrow>
      </div>
      <text class="abs title title-shadow" style="left: 4px; top: 86px">选择关卡</text>
      <text class="abs title" style="left: 0px; top: 82px">选择关卡</text>
      <div class="abs bar" style="left: 43px; top: 117px"></div>

      <!-- 2 列网格 @top148，卡片 74×68，列距 13，行距 8 -->
      <block for="{{ (i, item) in officialCards }}">
        <div class="abs shadow" show="{{ !item.locked }}" style="left: {{ item.left + 4 }}px; top: {{ item.top + 4 }}px; background-color: {{ item.selected ? '#FF5B8D' : '#111111' }}"></div>
        <div class="abs card" style="left: {{ item.left }}px; top: {{ item.top }}px; background-color: {{ item.locked ? '#D9D4CC' : item.selected ? '#FFD323' : '#FFFFFF' }}" @click="playOfficial(i)">
          <text class="card-no" style="color: {{ item.locked ? '#66615B' : '#111111' }}">{{ item.no }}</text>
          <text class="card-diff">{{ item.locked ? '锁定' : item.diff }}</text>
          <div class="check" show="{{ item.cleared }}"><text class="check-txt">✓</text></div>
        </div>
      </block>

      <!-- 进度卡 156×36 @top395 -->
      <div class="abs prog-shadow" style="left: 22px; top: 399px"></div>
      <div class="abs prog" style="left: 18px; top: 395px">
        <text class="prog-txt">已通关 {{ progress }} / {{ officialCount }}</text>
      </div>
    </stack>

    <!-- 页 2/3：统一自定义关卡，每页 2 列 × 3 行。 -->
    <stack if="{{ pageIndex > 0 }}" class="page">
      <div class="abs" style="left: 55px; top: 48px">
        <eyebrow label="CUSTOM" width="82" height="24"></eyebrow>
      </div>
      <text class="abs title title-shadow" style="left: 4px; top: 86px">自定义</text>
      <text class="abs title" style="left: 0px; top: 82px">自定义</text>
      <div class="abs bar" style="left: 43px; top: 117px"></div>
      <block for="{{ (ci, card) in customCards }}">
        <block if="{{ card.page === pageIndex && card.type === 'level' }}">
          <div class="abs shadow" style="left: {{ card.left + 4 }}px; top: {{ card.top + 4 }}px; background-color: #111111"></div>
          <div class="abs card" style="left: {{ card.left }}px; top: {{ card.top }}px; background-color: #FFFFFF" @click="playCustom(card.index)">
            <text class="card-no">{{ card.no }}</text>
            <text class="card-diff">{{ card.diffLabel }}</text>
          </div>
        </block>
        <block if="{{ card.page === pageIndex && card.type === 'add' }}">
          <div class="abs shadow" style="left: {{ card.left + 4 }}px; top: {{ card.top + 4 }}px; background-color: #D9D4CC"></div>
          <div class="abs card add-card" style="left: {{ card.left }}px; top: {{ card.top }}px">
            <text class="empty-plus">+</text>
          </div>
        </block>
      </block>
      <div class="abs prog-shadow" style="left: 22px; top: 399px"></div>
      <div class="abs prog" style="left: 18px; top: 395px">
        <text class="prog-txt">{{ pageIndex === 1 ? '01-06' : '07-12' }}</text>
      </div>
    </stack>
    <div class="abs pagination" style="left: 0px; top: 446px">
      <div class="page-dot" for="{{ pageDots }}" style="background-color: {{ $item.active ? '#FF5B8D' : '#F3EFE7' }}"></div>
    </div>
  </stack>
</template>

<script>
import router from '@system.router'
import { OFFICIAL, DIFFICULTY_LABEL } from '../../common/levels.js'
import { returnToPage } from '../../common/navigation.js'

import CustomLevels from '../../common/custom-levels.js'

const DIFF_SHORT = { easy: 'EASY', normal: 'NORMAL', hard: 'HARD', expert: 'EXPERT' }

export default {
  private: {
    pageIndex: 0,
    progress: 0,
    officialCount: OFFICIAL.length,
    officialCards: [],
    customCards: [],
    customCount: 0,
    hasSecondCustomPage: false,
    pageDots: []
  },

  onInit() {
    this.active = false
    this.buildCards()
    this.refreshCustomLevels()
  },

  onShow() {
    this.active = true
    this.leaving = false
    this.buildCards()
    this.refreshCustomLevels()
    if (!this.unsubscribeSlots) {
      this.unsubscribeSlots = this.$app.$def.slotStore.subscribe(() => this.refreshCustomLevels())
    }
    this.$app.$def.progressReady.then(() => {
      if (this.active) this.buildCards()
    })
    this.$app.$def.slotStore.ready.then(() => {
      if (this.active) this.refreshCustomLevels()
    })
  },

  onHide() {
    this.active = false
    this.touchStart = null
    if (this.unsubscribeSlots) this.unsubscribeSlots()
    this.unsubscribeSlots = null
  },

  onDestroy() {
    this.onHide()
  },

  /** Official 网格：2 列，卡 74×68，列距 13，行距 8，@top148，整体居中（74*2+13=161 → left 15） */
  buildCards() {
    const progress = this.$app.$def.progress
    if (this.officialCards.length && this.progress === progress) return
    this.progress = progress
    const cards = []
    for (let i = 0; i < OFFICIAL.length; i++) {
      const col = i % 2
      const row = Math.floor(i / 2)
      cards.push({
        no: String(i + 1),
        diff: DIFF_SHORT[OFFICIAL[i].difficulty],
        left: 15 + col * (74 + 13),
        top: 148 + row * (68 + 8),
        cleared: i < progress,
        selected: i === Math.min(progress, OFFICIAL.length - 1),
        locked: i > progress
      })
    }
    this.officialCards = cards
  },

  refreshCustomLevels() {
    const store = this.$app.$def.slotStore
    const levels = store.list()
    const cards = []
    for (let index = 0; index < levels.length; index++) {
      const level = levels[index]
      const localIndex = index % CustomLevels.CUSTOM_PAGE_SIZE
      cards.push({
        type: 'level',
        index,
        no: index + 1 < 10 ? '0' + (index + 1) : String(index + 1),
        page: 1 + Math.floor(index / CustomLevels.CUSTOM_PAGE_SIZE),
        level,
        diffLabel: DIFFICULTY_LABEL[level.difficulty] || '自定义',
        left: 15 + (localIndex % 2) * 87,
        top: 148 + Math.floor(localIndex / 2) * 76
      })
    }
    const count = levels.length
    if (count < CustomLevels.MAX_CUSTOM_LEVELS && (count === 0 || count % CustomLevels.CUSTOM_PAGE_SIZE !== 0)) {
      const localIndex = count % CustomLevels.CUSTOM_PAGE_SIZE
      cards.push({
        type: 'add',
        index: count,
        page: 1 + Math.floor(count / CustomLevels.CUSTOM_PAGE_SIZE),
        left: 15 + (localIndex % 2) * 87,
        top: 148 + Math.floor(localIndex / 2) * 76
      })
    }
    this.customCount = count
    this.hasSecondCustomPage = count >= 7
    this.customCards = cards
    this.pageIndex = Math.min(this.pageIndex, this.maxPageIndex())
    const pageCount = this.hasSecondCustomPage ? 3 : 2
    const dots = []
    for (let index = 0; index < pageCount; index++) dots.push({ index, active: index === this.pageIndex })
    this.pageDots = dots
  },

  maxPageIndex() {
    return this.hasSecondCustomPage ? 2 : 1
  },

  /** 单页手势只改变索引，不挂载隐藏的 Custom 页面。 */
  onTouchStart(e) {
    const touch = e.touches && e.touches[0]
    this.touchStart = touch ? { x: touch.clientX, y: touch.clientY, index: this.pageIndex } : null
  },

  onTouchEnd(e) {
    const start = this.touchStart
    this.touchStart = null
    const touch = e.changedTouches && e.changedTouches[0]
    if (!start || !touch || this.leaving) return
    const dx = touch.clientX - start.x
    const dy = touch.clientY - start.y
    if (Math.abs(dx) < 40 || Math.abs(dx) <= Math.abs(dy) * 1.5) return
    if (dx > 0) {
      if (start.index === 0) this.goHome()
      else this.pageIndex = start.index - 1
    } else if (start.index < this.maxPageIndex()) this.pageIndex = start.index + 1
  },

  goHome() {
    if (this.leaving) return
    this.leaving = true
    returnToPage('/pages/home')
  },

  onBackPress() {
    if (this.pageIndex > 0) this.pageIndex--
    else this.goHome()
    return true
  },

  playOfficial(i) {
    if (this.leaving || !this.officialCards[i] || this.officialCards[i].locked) return
    this.leaving = true
    this.$app.$def.feedback()
    router.push({ uri: '/pages/game', params: { pack: 'official', index: String(i) } })
  },

  playCustom(index) {
    const card = this.customCards.find((item) => item.type === 'level' && item.index === index)
    if (this.leaving || !card) return
    this.leaving = true
    this.$app.$def.feedback()
    router.push({ uri: '/pages/game', params: { pack: 'custom', index: String(index) } })
  }
}
</script>

<style>
.page {
  width: 192px;
  height: 490px;
  background-color: #f3efe7;
}
.abs {
  position: absolute;
}
.title {
  width: 192px;
  font-size: 33px;
  font-weight: 900;
  color: #111111;
  text-align: center;
}
.title-shadow {
  color: #ffd323;
}
.bar {
  width: 106px;
  height: 8px;
  background-color: #ff5b8d;
}
.shadow {
  width: 74px;
  height: 68px;
}
.card {
  width: 74px;
  height: 68px;
  border: 3px solid #111111;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.card-no {
  font-size: 26px;
  font-weight: 900;
}
.card-diff {
  font-size: 10px;
  font-weight: 900;
  color: #66615b;
  letter-spacing: 0.5px;
}
.check {
  position: absolute;
  right: 0px;
  top: 0px;
  width: 16px;
  height: 16px;
  background-color: #111111;
  justify-content: center;
  align-items: center;
}
.check-txt {
  color: #ffffff;
  font-size: 11px;
  font-weight: 900;
}
.prog-shadow {
  width: 156px;
  height: 36px;
  background-color: #ff5b8d;
}
.prog {
  width: 156px;
  height: 36px;
  background-color: #ffffff;
  border: 3px solid #111111;
  justify-content: center;
  align-items: center;
}
.prog-txt {
  font-size: 14px;
  font-weight: 900;
  color: #111111;
}
.empty-plus {
  font-size: 38px;
  color: #66615b;
  text-align: center;
}
.add-card {
  background-color: #f3efe7;
}
.pagination {
  width: 192px;
  height: 10px;
  justify-content: center;
  align-items: center;
}
.page-dot {
  width: 8px;
  height: 8px;
  margin-left: 4px;
  margin-right: 4px;
  border: 2px solid #111111;
  border-radius: 4px;
}
</style>
