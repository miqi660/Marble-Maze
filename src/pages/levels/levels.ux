<template>
  <stack class="page" @touchstart="onTouchStart" @touchend="onTouchEnd">
    <stack class="page page-content {{ slideClass }}">
    <!-- 页 1：Official -->
    <stack if="{{ pageIndex === 0 }}" class="page">
      <div class="abs" style="left: 57px; top: 48px">
        <text class="eyebrow" style="width: 78px">LEVELS</text>
      </div>
      <text class="abs title title-shadow" style="left: 20px; top: 86px">选择关卡</text>
      <text class="abs title" style="left: 16px; top: 82px">选择关卡</text>
      <div class="abs bar-shadow" style="left: 47px; top: 121px"></div>
      <div class="abs bar" style="left: 43px; top: 117px"></div>

      <!-- 2 列网格 @top148，卡片 74×68，列距 8，行距 13 -->
      <block for="{{ (i, item) in officialCards }}">
        <div class="abs shadow" style="left: {{ item.left + 4 }}px; top: {{ item.top + 4 }}px; background-color: {{ item.locked ? '#8A847C' : item.selected ? '#FF5B8D' : '#111111' }}"></div>
        <div class="abs card" style="left: {{ item.left }}px; top: {{ item.top }}px; background-color: {{ item.locked ? '#D9D4CC' : item.selected ? '#FFD323' : '#FFFFFF' }}" @click="playOfficial(i)">
          <text class="card-label" style="color: {{ item.locked ? '#77716A' : '#111111' }}">{{ item.locked ? '未解锁' : '关卡' }}</text>
          <text class="card-no" style="color: {{ item.locked ? '#77716A' : '#111111' }}">{{ item.no }}</text>
          <div class="check" show="{{ item.cleared }}"><text class="check-txt">✓</text></div>
          <div class="lock" show="{{ item.locked }}">
            <div class="lock-shackle"></div>
            <div class="lock-body"></div>
            <div class="lock-keyhole"></div>
            <div class="lock-keyhole-stem"></div>
          </div>
        </div>
      </block>

      <!-- 进度卡 156×36 @top395 -->
      <div class="abs prog-shadow" style="left: 22px; top: 399px"></div>
      <div class="abs prog prog-between" style="left: 18px; top: 395px">
        <text class="prog-label">已完成</text>
        <text class="prog-count">{{ progress }} / {{ officialCount }}</text>
      </div>
    </stack>

    <!-- 页 2/3：统一自定义关卡，每页 2 列 × 3 行。 -->
    <stack if="{{ pageIndex > 0 }}" class="page">
      <div class="abs" style="left: 55px; top: 48px">
        <text class="eyebrow" style="width: 82px">CUSTOM</text>
      </div>
      <text class="abs title title-shadow" style="left: 20px; top: 86px">自定义</text>
      <text class="abs title" style="left: 16px; top: 82px">自定义</text>
      <div class="abs bar-shadow" style="left: 47px; top: 121px"></div>
      <div class="abs bar" style="left: 43px; top: 117px"></div>
      <block for="{{ (ci, card) in customCards }}">
        <block if="{{ card.page === pageIndex && card.type === 'level' }}">
          <div class="abs shadow" style="left: {{ card.left + 4 }}px; top: {{ card.top + 4 }}px; background-color: #111111"></div>
          <div class="abs card" style="left: {{ card.left }}px; top: {{ card.top }}px; background-color: #FFFFFF" @click="playCustom(card.index)">
            <text class="card-label">{{ card.diffLabel }}</text>
            <text class="card-no">{{ card.no }}</text>
          </div>
        </block>
        <block if="{{ card.page === pageIndex && card.type === 'add' }}">
          <div class="abs shadow" style="left: {{ card.left + 4 }}px; top: {{ card.top + 4 }}px; background-color: #D9D4CC"></div>
          <div class="abs card add-card" style="left: {{ card.left }}px; top: {{ card.top }}px">
            <text class="empty-plus">+</text>
          </div>
        </block>
      </block>
      <div class="abs prog-shadow" style="left: 22px; top: 399px"></div>
      <div class="abs prog" style="left: 18px; top: 395px">
        <text class="prog-txt">{{ pageIndex === 1 ? '01-06' : '07-12' }}</text>
      </div>
    </stack>
    </stack>
    <div class="abs pagination" style="left: 0px; top: 446px">
      <div class="page-dot" for="{{ pageDots }}" style="background-color: {{ $item.active ? '#FF5B8D' : $item.index === 0 ? '#F3EFE7' : '#FFD323' }}; border-color: {{ $item.active ? '#FF5B8D' : '#111111' }}"></div>
    </div>
  </stack>
</template>

<script>
import router from '@system.router'
import { OFFICIAL, DIFFICULTY_LABEL } from '../../common/levels.js'
import { returnToPage } from '../../common/navigation.js'

import CustomLevels from '../../common/custom-levels.js'

export default {
  private: {
    pageIndex: 0,
    slideClass: '',
    progress: 0,
    officialCount: OFFICIAL.length,
    officialCards: [],
    customCards: [],
    customCount: 0,
    hasSecondCustomPage: false,
    pageDots: []
  },

  onInit() {
    this.active = false
    this.buildCards()
    this.refreshCustomLevels()
  },

  onShow() {
    this.active = true
    this.leaving = false
    this.buildCards()
    this.refreshCustomLevels()
    this.startWarmup()
    if (!this.unsubscribeSlots) {
      this.unsubscribeSlots = this.$app.$def.slotStore.subscribe(() => {
        this.refreshCustomLevels()
        this.startWarmup()
      })
    }
    this.$app.$def.progressReady.then(() => {
      if (this.active) this.buildCards()
    })
    this.$app.$def.slotStore.init().then(() => {
      if (this.active) this.refreshCustomLevels()
    })
  },

  onHide() {
    this.active = false
    this.stopWarmup()
    this.touchStart = null
    this.stopSlide()
    if (this.unsubscribeSlots) this.unsubscribeSlots()
    this.unsubscribeSlots = null
  },

  onDestroy() {
    this.onHide()
  },

  /** Official 网格：2 列，卡 74×68，列距 8，行距 13，@top148，左右各留 18 */
  buildCards() {
    const progress = this.$app.$def.progress
    if (this.officialCards.length && this.progress === progress) return
    this.progress = progress
    const cards = []
    for (let i = 0; i < OFFICIAL.length; i++) {
      const col = i % 2
      const row = Math.floor(i / 2)
      cards.push({
        no: i + 1 < 10 ? '0' + (i + 1) : String(i + 1),
        left: 18 + col * (74 + 8),
        top: 148 + row * (68 + 13),
        cleared: i < progress,
        selected: i === Math.min(progress, OFFICIAL.length - 1),
        locked: i > progress
      })
    }
    this.officialCards = cards
  },

  refreshCustomLevels() {
    const store = this.$app.$def.slotStore
    const levels = store.list()
    // 同一索引的布局和编号固定，只比较数量与实际展示的难度。
    if (this.customCards.length && this.customCount === levels.length && levels.every((level, index) =>
      this.customCards[index].diffLabel === (DIFFICULTY_LABEL[level.difficulty] || '自定义')
    )) return
    const cards = []
    for (let index = 0; index < levels.length; index++) {
      const level = levels[index]
      const localIndex = index % CustomLevels.CUSTOM_PAGE_SIZE
      cards.push({
        type: 'level',
        index,
        no: index + 1 < 10 ? '0' + (index + 1) : String(index + 1),
        page: 1 + Math.floor(index / CustomLevels.CUSTOM_PAGE_SIZE),
        diffLabel: DIFFICULTY_LABEL[level.difficulty] || '自定义',
        left: 18 + (localIndex % 2) * 82,
        top: 148 + Math.floor(localIndex / 2) * 81
      })
    }
    const count = levels.length
    if (count < CustomLevels.MAX_CUSTOM_LEVELS) {
      const localIndex = count % CustomLevels.CUSTOM_PAGE_SIZE
      cards.push({
        type: 'add',
        index: count,
        page: 1 + Math.floor(count / CustomLevels.CUSTOM_PAGE_SIZE),
        left: 18 + (localIndex % 2) * 82,
        top: 148 + Math.floor(localIndex / 2) * 81
      })
    }
    this.customCount = count
    this.hasSecondCustomPage = count >= CustomLevels.CUSTOM_PAGE_SIZE
    this.customCards = cards
    this.stopSlide()
    this.pageIndex = Math.min(this.pageIndex, this.maxPageIndex())
    this.updatePageDots()
    this.startWarmup()
  },

  stopWarmup() {
    this.warmupSession = null
    if (this.warmupTimer) clearTimeout(this.warmupTimer)
    this.warmupTimer = null
  },

  /** 翻页结束后逐关预热，每关之间归还事件循环。 */
  startWarmup() {
    this.stopWarmup()
    if (!this.active || this.leaving || this.slideClass || this.pageIndex === 0) return
    const store = this.$app.$def.slotStore
    let index = (this.pageIndex - 1) * CustomLevels.CUSTOM_PAGE_SIZE
    const end = Math.min(index + CustomLevels.CUSTOM_PAGE_SIZE, this.customCount)
    const session = {}
    this.warmupSession = session
    const next = () => {
      if (this.warmupSession !== session || !this.active || this.leaving) return
      this.warmupTimer = null
      if (index >= end || !store.get(index)) return
      store.getLevel(index++)
      if (index < end) this.warmupTimer = setTimeout(next, 0)
    }
    if (index < end) this.warmupTimer = setTimeout(next, 0)
  },

  updatePageDots() {
    const pageCount = this.hasSecondCustomPage ? 3 : 2
    const dots = []
    for (let index = 0; index < pageCount; index++) dots.push({ index, active: index === this.pageIndex })
    this.pageDots = dots
  },

  maxPageIndex() {
    return this.hasSecondCustomPage ? 2 : 1
  },

  /** 仅挂载当前页，按翻页方向滑入；动画期间避免重复翻页和误点。 */
  switchPage(index) {
    if (this.slideClass || this.leaving || index === this.pageIndex || index < 0 || index > this.maxPageIndex()) return
    this.slideClass = index > this.pageIndex ? 'slide-from-right' : 'slide-from-left'
    this.stopWarmup()
    this.pageIndex = index
    this.updatePageDots()
    this.slideTimer = setTimeout(() => {
      this.stopSlide()
      this.startWarmup()
    }, 220)
  },

  stopSlide() {
    if (this.slideTimer) clearTimeout(this.slideTimer)
    this.slideTimer = null
    this.slideClass = ''
  },

  onTouchStart(e) {
    const touch = e.touches && e.touches[0]
    this.touchStart = touch && !this.slideClass ? { x: touch.clientX, y: touch.clientY, index: this.pageIndex } : null
  },

  onTouchEnd(e) {
    const start = this.touchStart
    this.touchStart = null
    const touch = e.changedTouches && e.changedTouches[0]
    if (!start || !touch || this.leaving) return
    const dx = touch.clientX - start.x
    const dy = touch.clientY - start.y
    if (Math.abs(dx) < 40 || Math.abs(dx) <= Math.abs(dy) * 1.5) return
    if (dx > 0) {
      if (start.index === 0) this.goHome()
      else this.switchPage(start.index - 1)
    } else if (start.index < this.maxPageIndex()) this.switchPage(start.index + 1)
  },

  goHome() {
    if (this.leaving) return
    this.leaving = true
    this.stopWarmup()
    returnToPage('/pages/home')
  },

  onBackPress() {
    if (this.slideClass) return true
    if (this.pageIndex > 0) this.switchPage(this.pageIndex - 1)
    else this.goHome()
    return true
  },

  playOfficial(i) {
    if (this.leaving || this.slideClass || !this.officialCards[i] || this.officialCards[i].locked) return
    this.leaving = true
    this.stopWarmup()
    this.$app.$def.feedback()
    router.push({ uri: '/pages/game', params: { pack: 'official', index: String(i) } })
  },

  playCustom(index) {
    const card = this.customCards.find((item) => item.type === 'level' && item.index === index)
    if (this.leaving || this.slideClass || !card) return
    this.leaving = true
    this.stopWarmup()
    this.$app.$def.feedback()
    router.push({ uri: '/pages/game', params: { pack: 'custom', index: String(index) } })
  }
}
</script>

<style>
.page {
  width: 192px;
  height: 490px;
  background-color: #f3efe7;
}
.abs {
  position: absolute;
}
.page-content {
  animation-duration: 220ms;
  animation-timing-function: ease-out;
  animation-iteration-count: 1;
}
.slide-from-right {
  animation-name: slideFromRight;
}
.slide-from-left {
  animation-name: slideFromLeft;
}
@keyframes slideFromRight {
  0% { transform: translateX(192px); }
  100% { transform: translateX(0px); }
}
@keyframes slideFromLeft {
  0% { transform: translateX(-192px); }
  100% { transform: translateX(0px); }
}
.eyebrow {
  height: 24px;
  background-color: #111111;
  color: #ffffff;
  font-size: 12px;
  font-weight: 900;
  letter-spacing: 0.8px;
  text-align: center;
}
.title {
  width: 160px;
  height: 39px;
  letter-spacing: -2px;
  font-size: 33px;
  font-weight: 900;
  color: #111111;
  text-align: center;
}
.title-shadow {
  color: #ffd323;
}
.bar {
  width: 106px;
  height: 8px;
  background-color: #ff5b8d;
}
.bar-shadow {
  width: 106px;
  height: 8px;
  background-color: #111111;
}
.shadow {
  width: 74px;
  height: 68px;
}
.card {
  width: 74px;
  height: 68px;
  border: 3px solid #111111;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.card-no {
  position: absolute;
  left: 8px;
  bottom: 6px;
  height: 36px;
  color: #111111;
  font-size: 34px;
  font-weight: 900;
  letter-spacing: -2px;
}
.card-label {
  position: absolute;
  left: 8px;
  top: 7px;
  font-size: 11px;
  letter-spacing: 0px;
  font-weight: 900;
  color: #111111;
}
.check {
  position: absolute;
  right: 5px;
  top: 4px;
  width: 17px;
  height: 17px;
  background-color: #111111;
  justify-content: center;
  align-items: center;
}
.check-txt {
  color: #ffffff;
  font-size: 11px;
  font-weight: 900;
}
.lock {
  position: absolute;
  right: 4px;
  top: 6px;
  width: 16px;
  height: 20px;
}
.lock-shackle {
  position: absolute;
  left: 3px;
  top: 0px;
  width: 10px;
  height: 13px;
  border: 2px solid #111111;
  border-radius: 5px;
}
.lock-body {
  position: absolute;
  left: 0px;
  top: 8px;
  width: 16px;
  height: 12px;
  background-color: #111111;
  border-radius: 2px;
}
.lock-keyhole {
  position: absolute;
  left: 6px;
  top: 11px;
  width: 4px;
  height: 4px;
  border-radius: 2px;
  background-color: #d9d4cc;
}
.lock-keyhole-stem {
  position: absolute;
  left: 7px;
  top: 14px;
  width: 2px;
  height: 3px;
  background-color: #d9d4cc;
}
.prog-shadow {
  width: 156px;
  height: 36px;
  background-color: #ff5b8d;
}
.prog {
  width: 156px;
  height: 36px;
  background-color: #ffffff;
  border: 3px solid #111111;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}
.prog-between {
  justify-content: space-between;
  padding-left: 9px;
  padding-right: 9px;
}
.prog-label {
  font-size: 12px;
  font-weight: 900;
  color: #111111;
}
.prog-count {
  font-size: 20px;
  font-weight: 900;
  color: #111111;
}
.prog-txt {
  font-size: 14px;
  font-weight: 900;
  color: #111111;
}
.empty-plus {
  font-size: 38px;
  color: #66615b;
  text-align: center;
}
.add-card {
  background-color: #f3efe7;
}
.pagination {
  width: 192px;
  height: 10px;
  justify-content: center;
  align-items: center;
}
.page-dot {
  width: 9px;
  height: 9px;
  margin-left: 3.5px;
  margin-right: 3.5px;
  border: 2px solid #111111;
  border-radius: 5px;
}
</style>
