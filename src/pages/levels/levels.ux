
<template>
  <stack class="page container" @touchstart="onTouchStart" @touchend="onTouchEnd">
    <stack class="design-stage">
      <stack class="paper">
        <stack class="screen page-content {{ slideClass }}">
          <stack if="{{ pageIndex === 0 }}" class="screen">
            <text class="abs eyebrow" style="left: 20px; top: 18px; width: 78px">LEVELS</text>
            <text class="abs title" style="left: 0px; top: 48px">选择关卡</text>
            <div class="abs bar" style="left: 112px; top: 109px"></div>
            <block for="{{ (i, item) in officialCards }}">
              <div class="abs shadow" style="left: {{ item.left + 4 }}px; top: {{ item.top + 5 }}px; background-color: {{ item.selected ? '#FF3E8A' : '#111111' }}"></div>
              <stack class="abs card" style="left: {{ item.left }}px; top: {{ item.top }}px; background-color: {{ item.locked ? '#D9D4CC' : '#FFD522' }}" @click="playOfficial(i)">
                <text class="card-label" style="color: {{ item.locked ? '#777777' : '#111111' }}">{{ item.locked ? '未解锁' : '关卡' }}</text>
                <text class="card-no" style="color: {{ item.locked ? '#777777' : '#111111' }}">{{ item.no }}</text>
                <div class="check" show="{{ item.cleared }}"><text class="check-txt">✓</text></div>
                <stack class="lock" show="{{ item.locked }}"><div class="lock-shackle"></div><div class="lock-body"></div><div class="lock-keyhole"></div><div class="lock-keyhole-stem"></div></stack>
              </stack>
            </block>
            <stack class="abs prog" style="left: 16px; top: 371px">
              <text class="abs prog-label" style="left: 12px; top: 7px">已完成</text>
              <text class="abs prog-count" style="left: 185px; top: 7px">{{ progress }} / {{ officialCount }}</text>
              <stack class="abs track" style="left: 12px; top: 31px"><div class="fill" style="width: {{ progressWidth }}px"></div></stack>
            </stack>
          </stack>
          <stack if="{{ pageIndex > 0 }}" class="screen">
            <text class="abs eyebrow" style="left: 20px; top: 18px; width: 82px">CUSTOM</text>
            <text class="abs title" style="left: 0px; top: 48px">自定义</text>
            <div class="abs bar" style="left: 112px; top: 109px"></div>
            <block for="{{ (ci, card) in customCards }}">
              <block if="{{ card.page === pageIndex && card.type === 'level' }}">
                <div class="abs shadow" style="left: {{ card.left + 4 }}px; top: {{ card.top + 5 }}px; background-color: #111111"></div>
                <stack class="abs card" style="left: {{ card.left }}px; top: {{ card.top }}px; background-color: #FFD522" @click="playCustom(card.index)"><text class="card-label">{{ card.diffLabel }}</text><text class="card-no">{{ card.no }}</text></stack>
              </block>
              <block if="{{ card.page === pageIndex && card.type === 'add' }}">
                <div class="abs shadow" style="left: {{ card.left + 4 }}px; top: {{ card.top + 5 }}px; background-color: #A8A8A8"></div>
                <div class="abs card add-card" style="left: {{ card.left }}px; top: {{ card.top }}px"><text class="empty-plus">+</text></div>
              </block>
            </block>
            <div class="abs prog custom-progress" style="left: 16px; top: 371px"><text class="prog-txt">{{ pageIndex === 1 ? '01-06' : '07-12' }}</text></div>
          </stack>
        </stack>
        <div class="abs pagination" style="left: 0px; top: 440px"><div class="page-dot" for="{{ pageDots }}" style="background-color: {{ $item.active ? '#FF3E8A' : '#111111' }}"></div></div>
      </stack>
    </stack>
  </stack>
</template>

<script>
import router from '@system.router'
import { OFFICIAL, DIFFICULTY_LABEL } from '../../common/levels.js'
import { returnToPage } from '../../common/navigation.js'

import CustomLevels from '../../common/custom-levels.js'

export default {
  private: {
    pageIndex: 0,
    slideClass: '',
    progress: 0,
    progressWidth: 0,
    officialCount: OFFICIAL.length,
    officialCards: [],
    customCards: [],
    customCount: 0,
    hasSecondCustomPage: false,
    pageDots: []
  },

  onInit() {
    this.active = false
    this.buildCards()
    this.refreshCustomLevels()
  },

  onShow() {
    this.active = true
    this.leaving = false
    this.buildCards()
    this.refreshCustomLevels()
    this.startWarmup()
    if (!this.unsubscribeSlots) {
      this.unsubscribeSlots = this.$app.$def.slotStore.subscribe(() => {
        this.refreshCustomLevels()
        this.startWarmup()
      })
    }
    this.$app.$def.progressReady.then(() => {
      if (this.active) this.buildCards()
    })
    this.$app.$def.slotStore.init().then(() => {
      if (this.active) this.refreshCustomLevels()
    })
  },

  onHide() {
    this.active = false
    this.stopWarmup()
    this.touchStart = null
    this.stopSlide()
    if (this.unsubscribeSlots) this.unsubscribeSlots()
    this.unsubscribeSlots = null
  },

  onDestroy() {
    this.onHide()
  },

  /** Pro 网格：3 列 × 2 行，85×100，间隔 8，Paper 内坐标。 */
  buildCards() {
    const progress = this.$app.$def.progress
    if (this.officialCards.length && this.progress === progress) return
    this.progress = progress
    this.progressWidth = 248 * Math.max(0, Math.min(progress, OFFICIAL.length)) / OFFICIAL.length
    const cards = []
    for (let i = 0; i < OFFICIAL.length; i++) {
      const col = i % 3
      const row = Math.floor(i / 3)
      cards.push({
        no: i + 1 < 10 ? '0' + (i + 1) : String(i + 1),
        left: 16 + col * (85 + 8),
        top: 137 + row * (100 + 8),
        cleared: i < progress,
        selected: i === Math.min(progress, OFFICIAL.length - 1),
        locked: i > progress
      })
    }
    this.officialCards = cards
  },

  refreshCustomLevels() {
    const store = this.$app.$def.slotStore
    const levels = store.list()
    // 同一索引的布局和编号固定，只比较数量与实际展示的难度。
    if (this.customCards.length && this.customCount === levels.length && levels.every((level, index) =>
      this.customCards[index].diffLabel === (DIFFICULTY_LABEL[level.difficulty] || '自定义')
    )) return
    const cards = []
    for (let index = 0; index < levels.length; index++) {
      const level = levels[index]
      const localIndex = index % CustomLevels.CUSTOM_PAGE_SIZE
      cards.push({
        type: 'level',
        index,
        no: index + 1 < 10 ? '0' + (index + 1) : String(index + 1),
        page: 1 + Math.floor(index / CustomLevels.CUSTOM_PAGE_SIZE),
        diffLabel: DIFFICULTY_LABEL[level.difficulty] || '自定义',
        left: 16 + (localIndex % 3) * 93,
        top: 137 + Math.floor(localIndex / 3) * 108
      })
    }
    const count = levels.length
    if (count < CustomLevels.MAX_CUSTOM_LEVELS) {
      const localIndex = count % CustomLevels.CUSTOM_PAGE_SIZE
      cards.push({
        type: 'add',
        index: count,
        page: 1 + Math.floor(count / CustomLevels.CUSTOM_PAGE_SIZE),
        left: 16 + (localIndex % 3) * 93,
        top: 137 + Math.floor(localIndex / 3) * 108
      })
    }
    this.customCount = count
    this.hasSecondCustomPage = count >= CustomLevels.CUSTOM_PAGE_SIZE
    this.customCards = cards
    this.stopSlide()
    this.pageIndex = Math.min(this.pageIndex, this.maxPageIndex())
    this.updatePageDots()
    this.startWarmup()
  },

  stopWarmup() {
    this.warmupSession = null
    if (this.warmupTimer) clearTimeout(this.warmupTimer)
    this.warmupTimer = null
  },

  /** 翻页结束后逐关预热，每关之间归还事件循环。 */
  startWarmup() {
    this.stopWarmup()
    if (!this.active || this.leaving || this.slideClass || this.pageIndex === 0) return
    const store = this.$app.$def.slotStore
    let index = (this.pageIndex - 1) * CustomLevels.CUSTOM_PAGE_SIZE
    const end = Math.min(index + CustomLevels.CUSTOM_PAGE_SIZE, this.customCount)
    const session = {}
    this.warmupSession = session
    const next = () => {
      if (this.warmupSession !== session || !this.active || this.leaving) return
      this.warmupTimer = null
      if (index >= end || !store.get(index)) return
      store.getLevel(index++)
      if (index < end) this.warmupTimer = setTimeout(next, 0)
    }
    if (index < end) this.warmupTimer = setTimeout(next, 0)
  },

  updatePageDots() {
    const pageCount = this.hasSecondCustomPage ? 3 : 2
    const dots = []
    for (let index = 0; index < pageCount; index++) dots.push({ index, active: index === this.pageIndex })
    this.pageDots = dots
  },

  maxPageIndex() {
    return this.hasSecondCustomPage ? 2 : 1
  },

  /** 仅挂载当前页，按翻页方向滑入；动画期间避免重复翻页和误点。 */
  switchPage(index) {
    if (this.slideClass || this.leaving || index === this.pageIndex || index < 0 || index > this.maxPageIndex()) return
    this.slideClass = index > this.pageIndex ? 'slide-from-right' : 'slide-from-left'
    this.stopWarmup()
    this.pageIndex = index
    this.updatePageDots()
    this.slideTimer = setTimeout(() => {
      this.stopSlide()
      this.startWarmup()
    }, 220)
  },

  stopSlide() {
    if (this.slideTimer) clearTimeout(this.slideTimer)
    this.slideTimer = null
    this.slideClass = ''
  },

  onTouchStart(e) {
    const touch = e.touches && e.touches[0]
    this.touchStart = touch && !this.slideClass ? { x: touch.clientX, y: touch.clientY, index: this.pageIndex } : null
  },

  onTouchEnd(e) {
    const start = this.touchStart
    this.touchStart = null
    const touch = e.changedTouches && e.changedTouches[0]
    if (!start || !touch || this.leaving) return
    const dx = touch.clientX - start.x
    const dy = touch.clientY - start.y
    if (Math.abs(dx) < 40 || Math.abs(dx) <= Math.abs(dy) * 1.5) return
    if (dx > 0) {
      if (start.index === 0) this.goHome()
      else this.switchPage(start.index - 1)
    } else if (start.index < this.maxPageIndex()) this.switchPage(start.index + 1)
  },

  goHome() {
    if (this.leaving) return
    this.leaving = true
    this.stopWarmup()
    returnToPage('/pages/home')
  },

  onBackPress() {
    if (this.slideClass) return true
    if (this.pageIndex > 0) this.switchPage(this.pageIndex - 1)
    else this.goHome()
    return true
  },

  playOfficial(i) {
    if (this.leaving || this.slideClass || !this.officialCards[i] || this.officialCards[i].locked) return
    this.leaving = true
    this.stopWarmup()
    this.$app.$def.feedback()
    router.push({ uri: '/pages/game', params: { pack: 'official', index: String(i) } })
  },

  playCustom(index) {
    const card = this.customCards.find((item) => item.type === 'level' && item.index === index)
    if (this.leaving || this.slideClass || !card) return
    this.leaving = true
    this.stopWarmup()
    this.$app.$def.feedback()
    router.push({ uri: '/pages/game', params: { pack: 'custom', index: String(index) } })
  }
}
</script>

<style>
.page { width: 100%; height: 100%; background-color: #090909; }
.container { position: absolute; left: 0px; top: 0px; overflow: hidden; }
.design-stage { position: absolute; left: 0px; top: 0px; width: 336px; height: 480px; }
.paper { position: absolute; left: 16px; top: 0px; width: 304px; height: 480px; background-color: #FAF8F3; }
.abs { position: absolute; }
.paper { border-radius: 24px; }
.screen { width: 304px; height: 480px; }
.page-content { animation-duration: 220ms; animation-timing-function: ease-out; animation-iteration-count: 1; }
.slide-from-right { animation-name: slideFromRight; }
.slide-from-left { animation-name: slideFromLeft; }
@keyframes slideFromRight { 0% { transform: translateX(336px); } 100% { transform: translateX(0px); } }
@keyframes slideFromLeft { 0% { transform: translateX(-336px); } 100% { transform: translateX(0px); } }
.eyebrow { height: 24px; background-color: #111111; color: #FAF8F3; font-size: 13px; font-weight: 900; text-align: center; border-radius: 4px; }
.title { width: 304px; height: 44px; font-size: 32px; font-weight: 900; color: #111111; text-align: center; }
.bar { width: 80px; height: 4px; background-color: #FF3E8A; border-radius: 2px; }
.shadow, .card { width: 85px; height: 100px; }
.card { border: 3px solid #111111; justify-content: center; align-items: center; }
.card-label { position: absolute; left: 7px; top: 10px; font-size: 12px; font-weight: 900; color: #111111; }
.card-no { position: absolute; left: 7px; top: 32px; width: 70px; height: 61px; font-size: 50px; font-weight: 900; color: #111111; letter-spacing: -2px; }
.check { position: absolute; right: 5px; top: 7px; width: 17px; height: 17px; background-color: #111111; justify-content: center; align-items: center; }
.check-txt { color: #FAF8F3; font-size: 11px; font-weight: 900; }
.lock { position: absolute; right: 4px; top: 7px; width: 16px; height: 20px; }
.lock-shackle { position: absolute; left: 3px; top: 0px; width: 10px; height: 13px; border: 2px solid #111111; border-radius: 5px; }
.lock-body { position: absolute; left: 0px; top: 8px; width: 16px; height: 12px; background-color: #111111; border-radius: 2px; }
.lock-keyhole { position: absolute; left: 6px; top: 11px; width: 4px; height: 4px; border-radius: 2px; background-color: #D9D4CC; }
.lock-keyhole-stem { position: absolute; left: 7px; top: 14px; width: 2px; height: 3px; background-color: #D9D4CC; }
.prog { width: 272px; height: 53px; background-color: #FAF8F3; border: 2.5px solid #FF3E8A; border-radius: 6px; }
.prog-label, .prog-count { height: 20px; font-size: 14px; font-weight: 900; color: #111111; }
.prog-count { width: 75px; text-align: right; }
.track { width: 248px; height: 10px; border-radius: 5px; background-color: #E5E5E5; }
.fill { height: 10px; border-radius: 5px; background-color: #FFD522; }
.custom-progress { justify-content: center; align-items: center; }
.prog-txt { font-size: 18px; font-weight: 900; color: #111111; }
.empty-plus { font-size: 52px; font-weight: 900; color: #A4A4A4; text-align: center; }
.add-card { background-color: #F4F5F5; }
.pagination { width: 304px; height: 10px; justify-content: center; align-items: center; }
.page-dot { width: 10px; height: 10px; margin-left: 4px; margin-right: 4px; border-radius: 5px; }

</style>
