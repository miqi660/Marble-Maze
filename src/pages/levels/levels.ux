<import name="eyebrow" src="../../common/ui/eyebrow.ux"></import>

<template>
  <stack class="page" @touchstart="onTouchStart" @touchend="onTouchEnd">
    <!-- 页 1：Official -->
    <stack if="{{ pageIndex === 0 }}" class="page">
      <div class="abs" style="left: 63px; top: 48px">
        <eyebrow label="LEVELS" width="66" height="24"></eyebrow>
      </div>
      <text class="abs title title-shadow" style="left: 4px; top: 86px">选择关卡</text>
      <text class="abs title" style="left: 0px; top: 82px">选择关卡</text>
      <div class="abs bar" style="left: 43px; top: 117px"></div>

      <!-- 2 列网格 @top148，卡片 74×68，列距 13，行距 8 -->
      <block for="{{ (i, item) in officialCards }}">
        <div class="abs shadow" show="{{ !item.locked }}" style="left: {{ item.left + 4 }}px; top: {{ item.top + 4 }}px; background-color: {{ item.selected ? '#FF5B8D' : '#111111' }}"></div>
        <div class="abs card" style="left: {{ item.left }}px; top: {{ item.top }}px; background-color: {{ item.locked ? '#D9D4CC' : item.selected ? '#FFD323' : '#FFFFFF' }}" @click="playOfficial(i)">
          <text class="card-no" style="color: {{ item.locked ? '#66615B' : '#111111' }}">{{ item.no }}</text>
          <text class="card-diff">{{ item.locked ? '锁定' : item.diff }}</text>
          <div class="check" show="{{ item.cleared }}"><text class="check-txt">✓</text></div>
        </div>
      </block>

      <!-- 进度卡 156×36 @top395 -->
      <div class="abs prog-shadow" style="left: 22px; top: 399px"></div>
      <div class="abs prog" style="left: 18px; top: 395px">
        <text class="prog-txt">已通关 {{ progress }} / {{ officialCount }}</text>
      </div>
    </stack>

    <!-- 页 2/3：统一自定义关卡，每页 2 列 × 3 行。 -->
    <stack if="{{ pageIndex > 0 }}" class="page">
      <div class="abs" style="left: 55px; top: 48px">
        <eyebrow label="CUSTOM" width="82" height="24"></eyebrow>
      </div>
      <text class="abs title title-shadow" style="left: 4px; top: 86px">自定义</text>
      <text class="abs title" style="left: 0px; top: 82px">自定义</text>
      <div class="abs bar" style="left: 43px; top: 117px"></div>
      <block for="{{ (ci, slot) in slots }}">
        <block if="{{ slot.page === pageIndex }}">
          <div class="abs shadow" style="left: {{ slot.left + 4 }}px; top: {{ slot.top + 4 }}px; background-color: {{ slot.level ? '#111111' : '#D9D4CC' }}"></div>
          <div class="abs card" style="left: {{ slot.left }}px; top: {{ slot.top }}px; background-color: {{ slot.level ? '#FFFFFF' : '#F3EFE7' }}" @click="playCustom(slot.key)">
            <text if="{{ !!slot.level }}" class="card-no">{{ slot.no }}</text>
            <text if="{{ !!slot.level }}" class="card-diff">{{ slot.diffLabel }}</text>
            <text if="{{ !slot.level }}" class="empty-plus">+</text>
          </div>
        </block>
      </block>
      <div class="abs prog-shadow" style="left: 22px; top: 399px"></div>
      <div class="abs prog" style="left: 18px; top: 395px">
        <text class="prog-txt">{{ pageIndex === 1 ? '1/6' : '7/12' }}</text>
      </div>
    </stack>
    <div class="abs pagination" style="left: 0px; top: 446px">
      <div class="page-dot" style="background-color: {{ pageIndex === 0 ? '#FF5B8D' : '#F3EFE7' }}"></div>
      <div class="page-dot" style="background-color: {{ pageIndex === 1 ? '#FF5B8D' : '#F3EFE7' }}"></div>
      <div class="page-dot" style="background-color: {{ pageIndex === 2 ? '#FF5B8D' : '#F3EFE7' }}"></div>
    </div>
  </stack>
</template>

<script>
import router from '@system.router'
import { OFFICIAL, DIFFICULTY_LABEL } from '../../common/levels.js'
import { returnToPage } from '../../common/navigation.js'

import CustomSlots from '../../common/custom-slots.js'

const DIFF_SHORT = { easy: 'EASY', normal: 'NORMAL', hard: 'HARD', expert: 'EXPERT' }

export default {
  private: {
    pageIndex: 0,
    progress: 0,
    officialCount: OFFICIAL.length,
    officialCards: [],
    slots: []
  },

  onInit() {
    this.active = false
    this.buildCards()
    this.refreshSlots()
  },

  onShow() {
    this.active = true
    this.leaving = false
    this.buildCards()
    this.refreshSlots()
    if (!this.unsubscribeSlots) {
      this.unsubscribeSlots = this.$app.$def.slotStore.subscribe((slot, slim) => this.applySlot(slot, slim))
    }
    this.$app.$def.progressReady.then(() => {
      if (this.active) this.buildCards()
    })
    this.$app.$def.slotStore.ready.then(() => {
      if (this.active) this.refreshSlots()
    })
  },

  onHide() {
    this.active = false
    this.touchStart = null
    if (this.unsubscribeSlots) this.unsubscribeSlots()
    this.unsubscribeSlots = null
  },

  onDestroy() {
    this.onHide()
  },

  /** Official 网格：2 列，卡 74×68，列距 13，行距 8，@top148，整体居中（74*2+13=161 → left 15） */
  buildCards() {
    const progress = this.$app.$def.progress
    if (this.officialCards.length && this.progress === progress) return
    this.progress = progress
    const cards = []
    for (let i = 0; i < OFFICIAL.length; i++) {
      const col = i % 2
      const row = Math.floor(i / 2)
      cards.push({
        no: String(i + 1),
        diff: DIFF_SHORT[OFFICIAL[i].difficulty],
        left: 15 + col * (74 + 13),
        top: 148 + row * (68 + 8),
        cleared: i < progress,
        selected: i === Math.min(progress, OFFICIAL.length - 1),
        locked: i > progress
      })
    }
    this.officialCards = cards
  },

  refreshSlots() {
    const store = this.$app.$def.slotStore
    this.slots = CustomSlots.keys.map((key, i) => {
      const level = store.get(key)
      return {
        key,
        no: String(i + 1),
        page: 1 + Math.floor(i / 6),
        left: 15 + (i % 2) * 87,
        top: 148 + Math.floor((i % 6) / 2) * 76,
        level,
        diffLabel: level ? DIFFICULTY_LABEL[level.difficulty] || '自定义' : ''
      }
    })
  },

  applySlot() {
    this.refreshSlots()
  },

  /** 单页手势只改变索引，不挂载隐藏的 Custom 页面。 */
  onTouchStart(e) {
    const touch = e.touches && e.touches[0]
    this.touchStart = touch ? { x: touch.clientX, y: touch.clientY, index: this.pageIndex } : null
  },

  onTouchEnd(e) {
    const start = this.touchStart
    this.touchStart = null
    const touch = e.changedTouches && e.changedTouches[0]
    if (!start || !touch || this.leaving) return
    const dx = touch.clientX - start.x
    const dy = touch.clientY - start.y
    if (Math.abs(dx) < 40 || Math.abs(dx) <= Math.abs(dy) * 1.5) return
    if (dx > 0) {
      if (start.index === 0) this.goHome()
      else this.pageIndex = start.index - 1
    } else this.pageIndex = Math.min(2, start.index + 1)
  },

  goHome() {
    if (this.leaving) return
    this.leaving = true
    returnToPage('/pages/home')
  },

  onBackPress() {
    if (this.pageIndex > 0) this.pageIndex--
    else this.goHome()
    return true
  },

  playOfficial(i) {
    if (this.leaving || !this.officialCards[i] || this.officialCards[i].locked) return
    this.leaving = true
    this.$app.$def.feedback()
    router.push({ uri: '/pages/game', params: { pack: 'official', index: String(i) } })
  },

  playCustom(slot) {
    const s = this.slots[CustomSlots.keys.indexOf(slot)]
    if (this.leaving || !s || !s.level) return
    this.leaving = true
    this.$app.$def.feedback()
    router.push({ uri: '/pages/game', params: { pack: 'custom_' + slot, index: '0' } })
  }
}
</script>

<style>
.page {
  width: 192px;
  height: 490px;
  background-color: #f3efe7;
}
.abs {
  position: absolute;
}
.title {
  width: 192px;
  font-size: 33px;
  font-weight: 900;
  color: #111111;
  text-align: center;
}
.title-shadow {
  color: #ffd323;
}
.bar {
  width: 106px;
  height: 8px;
  background-color: #ff5b8d;
}
.shadow {
  width: 74px;
  height: 68px;
}
.card {
  width: 74px;
  height: 68px;
  border: 3px solid #111111;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.card-no {
  font-size: 26px;
  font-weight: 900;
}
.card-diff {
  font-size: 10px;
  font-weight: 900;
  color: #66615b;
  letter-spacing: 0.5px;
}
.check {
  position: absolute;
  right: 0px;
  top: 0px;
  width: 16px;
  height: 16px;
  background-color: #111111;
  justify-content: center;
  align-items: center;
}
.check-txt {
  color: #ffffff;
  font-size: 11px;
  font-weight: 900;
}
.prog-shadow {
  width: 156px;
  height: 36px;
  background-color: #ff5b8d;
}
.prog {
  width: 156px;
  height: 36px;
  background-color: #ffffff;
  border: 3px solid #111111;
  justify-content: center;
  align-items: center;
}
.prog-txt {
  font-size: 14px;
  font-weight: 900;
  color: #111111;
}
.empty-plus {
  font-size: 38px;
  color: #66615b;
  text-align: center;
}
.pagination {
  width: 192px;
  height: 10px;
  justify-content: center;
  align-items: center;
}
.page-dot {
  width: 8px;
  height: 8px;
  margin-left: 4px;
  margin-right: 4px;
  border: 2px solid #111111;
  border-radius: 4px;
}
</style>
