<import name="btn-hard" src="../../common/ui/btn-hard.ux"></import>
<import name="eyebrow" src="../../common/ui/eyebrow.ux"></import>

<template>
  <stack class="page container">
    <stack class="design-stage">
      <div class="abs row" style="left: 0px; top: 50px">
        <eyebrow label="{{ levelName }}" width="66" height="24"></eyebrow>
      </div>

      <!-- 标题“通关!”：黄色阴影层偏移 5px -->
      <text class="abs title title-shadow" style="left: 5px; top: 99px">通关!</text>
      <text class="abs title" style="left: 0px; top: 94px">通关!</text>

      <!-- 成功图形：粉环 82 + 黄球 42 + ✓ -->
      <div class="abs ring-shadow" style="left: 60px; top: 169px"></div>
      <div class="abs ring" style="left: 55px; top: 164px">
        <div class="ball">
          <text class="check">✓</text>
        </div>
      </div>

      <!-- 结果卡 -->
      <div class="abs card-shadow" style="left: 26px; top: 282px"></div>
      <div class="abs card" style="left: 22px; top: 278px">
        <text class="card-label">用时</text>
        <text class="card-value">{{ time }}s</text>
      </div>

      <div class="abs" style="left: 16px; top: 344px" @click="onNext">
        <btn-hard label="{{ hasNext ? '下一关' : '重玩' }}" width="160" height="58" bg="#FFD323" shadow="#FF5B8D" font-size="22"></btn-hard>
      </div>
      <div class="abs" style="left: 24px; top: 414px" @click="onBack">
        <btn-hard label="返回关卡" width="144" height="40" bg="#FFFFFF" shadow="#FFD323" font-size="16"></btn-hard>
      </div>
    </stack>
  </stack>
</template>

<script>
import router from '@system.router'
import { OFFICIAL } from '../../common/levels.js'
import CustomLevels from '../../common/custom-levels.js'
import { returnToPage } from '../../common/navigation.js'

export default {
  protected: {
    pack: 'official',
    index: 0,
    time: '00.0'
  },
  private: {
    levelName: 'LEVEL',
    hasNext: false
  },
  onInit() {
    const parsedIndex = parseInt(this.index, 10)
    const requestedIndex = isNaN(parsedIndex) ? 0 : parsedIndex
    if (this.pack === 'official') {
      this.index = Math.max(0, Math.min(OFFICIAL.length - 1, requestedIndex))
      this.levelName = 'LEVEL ' + (this.index + 1)
      this.hasNext = this.index < OFFICIAL.length - 1
    } else if (this.pack === 'custom') {
      this.index = Math.max(0, Math.min(CustomLevels.MAX_CUSTOM_LEVELS - 1, requestedIndex))
      const no = this.index + 1
      this.levelName = '自定义' + (no < 10 ? '0' + no : String(no))
      this.hasNext = false
    } else {
      this.index = 0
      this.levelName = 'LEVEL'
      this.hasNext = false
    }
  },
  onNext() {
    if (this.leaving) return
    this.leaving = true
    const next = this.hasNext ? this.index + 1 : this.index
    router.replace({ uri: '/pages/game', params: { pack: this.pack, index: String(next) } })
  },
  onBack() {
    if (this.leaving) return
    this.leaving = true
    returnToPage('/pages/levels')
  },
  onShow() {
    this.leaving = false
  },
  onBackPress() {
    this.onBack()
    return true
  }
}
</script>

