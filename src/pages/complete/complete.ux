<import name="btn-hard" src="../../common/ui/btn-hard.ux"></import>
<import name="eyebrow" src="../../common/ui/eyebrow.ux"></import>
<template>
  <stack class="page container">
    <stack class="design-stage">
      <stack class="paper">
        <div class="abs row" style="left: 16px; top: 24px"><eyebrow label="{{ levelName }}" width="118" height="28" font-size="16"></eyebrow></div>
        <text class="abs title title-shadow" style="left: 21px; top: 77px">通关!</text><text class="abs title" style="left: 16px; top: 72px">通关!</text>
        <div class="abs ring-shadow" style="left: 125px; top: 153px"></div><div class="abs ring" style="left: 120px; top: 148px"><div class="ball"><text class="check">✓</text></div></div>
        <div class="abs card-shadow" style="left: 47px; top: 269px"></div><div class="abs card" style="left: 40px; top: 261px"><text class="card-label">用时</text><text class="card-value">{{ time }}s</text></div>
        <div class="abs" style="left: 36px; top: 338px" @click="onNext"><btn-hard label="{{ hasNext ? '下一关' : '重玩' }}" width="264" height="58" shadow="#FF2E78" shadow-x="7" shadow-y="8" font-size="28"></btn-hard></div>
        <div class="abs" style="left: 51px; top: 414px" @click="onBack"><btn-hard label="返回关卡" width="234" height="44" bg="#FAF8F3" shadow="#FFD522" shadow-x="5" shadow-y="6" font-size="22"></btn-hard></div>
      </stack>
    </stack>
  </stack>
</template>

<script>
import router from '@system.router'
import { OFFICIAL } from '../../common/levels.js'
import CustomLevels from '../../common/custom-levels.js'
import { returnToPage } from '../../common/navigation.js'

export default {
  protected: {
    pack: 'official',
    index: 0,
    time: '00.0'
  },
  private: {
    levelName: 'LEVEL',
    hasNext: false
  },
  onInit() {
    const parsedIndex = parseInt(this.index, 10)
    const requestedIndex = isNaN(parsedIndex) ? 0 : parsedIndex
    if (this.pack === 'official') {
      this.index = Math.max(0, Math.min(OFFICIAL.length - 1, requestedIndex))
      this.levelName = 'LEVEL ' + (this.index + 1)
      this.hasNext = this.index < OFFICIAL.length - 1
    } else if (this.pack === 'custom') {
      this.index = Math.max(0, Math.min(CustomLevels.MAX_CUSTOM_LEVELS - 1, requestedIndex))
      const no = this.index + 1
      this.levelName = '自定义' + (no < 10 ? '0' + no : String(no))
      this.hasNext = false
    } else {
      this.index = 0
      this.levelName = 'LEVEL'
      this.hasNext = false
    }
  },
  onNext() {
    if (this.leaving) return
    this.leaving = true
    const next = this.hasNext ? this.index + 1 : this.index
    router.replace({ uri: '/pages/game', params: { pack: this.pack, index: String(next) } })
  },
  onBack() {
    if (this.leaving) return
    this.leaving = true
    returnToPage('/pages/levels')
  },
  onShow() {
    this.leaving = false
  },
  onBackPress() {
    this.onBack()
    return true
  }
}
</script>

<style>
.page { width: 100%; height: 100%; background-color: #FAF8F3; }
.container { position: absolute; left: 0px; top: 0px; overflow: hidden; }
.design-stage { position: absolute; left: 0px; top: 0px; width: 336px; height: 480px; }
.paper { position: absolute; left: 0px; top: 0px; width: 336px; height: 480px; background-color: #FAF8F3; }
.abs { position: absolute; }
.row { width: 304px; justify-content: center; }
.title { width: 304px; height: 68px; font-size: 56px; font-weight: bold; color: #111111; text-align: center; }
.title-shadow { color: #FFD522; }
.ring-shadow, .ring { width: 96px; height: 96px; border-radius: 48px; }
.ring-shadow { background-color: #111111; }
.ring { background-color: #FF2E78; border: 3px solid #111111; justify-content: center; align-items: center; }
.ball { width: 52px; height: 52px; border-radius: 26px; background-color: #FFD522; border: 3px solid #111111; justify-content: center; align-items: center; }
.check { font-size: 28px; font-weight: bold; color: #111111; }
.card-shadow, .card { width: 256px; height: 55px; }
.card-shadow { background-color: #FF2E78; }
.card { background-color: #F4F5F5; border: 3px solid #111111; align-items: center; justify-content: space-between; padding: 0px 18px; }
.card-label { font-size: 20px; font-weight: bold; color: #111111; }
.card-value { font-size: 28px; font-weight: bold; color: #111111; }
</style>
