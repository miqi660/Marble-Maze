  width: 192px;
  height: 490px;
  background-color: #f3efe7;
}
.abs {
  position: absolute;
}
.row {
  width: 192px;
  justify-content: center;
}
.title {
  width: 192px;
  font-size: 52px;
  font-weight: 900;
  color: #111111;
  text-align: center;
}
.title-shadow {
  color: #ffd323;
}
.ring-shadow {
  width: 82px;
  height: 82px;
  border-radius: 41px;
  background-color: #111111;
}
.ring {
  width: 82px;
  height: 82px;
  border-radius: 41px;
  background-color: #ff5b8d;
  border: 3px solid #111111;
  justify-content: center;
  align-items: center;
}
.ball {
  width: 42px;
  height: 42px;
  border-radius: 21px;
  background-color: #ffd323;
  border: 3px solid #111111;
  justify-content: center;
  align-items: center;
}
.check {
  font-size: 22px;
  font-weight: 900;
  color: #111111;
}
.card-shadow {
  width: 148px;
  height: 52px;
  background-color: #ff5b8d;
}
.card {
  width: 148px;
  height: 52px;
  background-color: #ffffff;
  border: 3px solid #111111;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 12px;
}
.card-label {
  font-size: 14px;
  color: #66615b;
  font-weight: 900;
}
.card-value {
  font-size: 22px;
  color: #111111;
  font-weight: 900;
}
</style>
