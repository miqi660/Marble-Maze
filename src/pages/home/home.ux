<import name="btn-hard" src="../../common/ui/btn-hard.ux"></import>
<import name="eyebrow" src="../../common/ui/eyebrow.ux"></import>
<import name="dots" src="../../common/ui/dots.ux"></import>
<template>
  <stack class="page container">
    <stack class="design-stage">
      <stack class="paper">
        <div class="abs" style="left: 36px; top: 21px"><eyebrow label="{{ levelLabel }}" width="84" height="28" font-size="14"></eyebrow></div>
        <text class="abs title title-shadow" style="left: 41px; top: 71.5px">腕上</text>
        <text class="abs title" style="left: 36px; top: 66.5px">腕上</text>
        <div class="abs badge" style="left: 174px; top: 64px"><text class="badge-text">迷宫</text></div>
        <text class="abs english" style="left: 36px; top: 156px">TILT TO PLAY</text>
        <text class="abs instruction" style="left: 36px; top: 176px">倾斜手环 · 滚球到终点</text>
        <div class="abs underline" style="left: 36px; top: 215px"></div>
        <div class="abs" style="left: 36px; top: 259px" @click="goLevels"><btn-hard label="开始" width="264" height="68" font-size="36" shadow-x="7" shadow-y="8"></btn-hard></div>
        <div class="abs" style="left: 51px; top: 355px" @click="goSettings"><btn-hard label="设置" width="234" height="65" bg="#FAF8F3" shadow="#FF2E78" font-size="28" shadow-x="7" shadow-y="8"></btn-hard></div>
        <div class="abs" style="left: 0px; top: 448px"><dots width="336"></dots></div>
      </stack>
    </stack>
  </stack>
</template>

<script>
import router from '@system.router'
import { OFFICIAL } from '../../common/levels.js'

export default {
  private: {
    levelLabel: 'LEVEL 01'
  },
  onShow() {
    this.$app.$def.progressReady.then(() => {
      if (!this.$valid) return
      const n = Math.min(this.$app.$def.progress + 1, OFFICIAL.length)
      this.levelLabel = 'LEVEL ' + (n < 10 ? '0' + n : n)
    })
  },
  goLevels() {
    router.push({ uri: '/pages/levels' })
  },
  goSettings() {
    router.push({ uri: '/pages/settings' })
  }
}
</script>

<style>
.page { width: 100%; height: 100%; background-color: #FAF8F3; }
.container { position: absolute; left: 0px; top: 0px; overflow: hidden; }
.design-stage { position: absolute; left: 0px; top: 0px; width: 336px; height: 480px; }
.paper { position: absolute; left: 0px; top: 0px; width: 336px; height: 480px; background-color: #FAF8F3; }
.abs { position: absolute; }
.title { width: 128px; height: 82px; font-size: 64px; font-weight: bold; letter-spacing: -3px; color: #111111; }
.title-shadow { color: #FFD522; }
.badge { width: 122px; height: 82px; background-color: #FFD522; border: 3px solid #111111; justify-content: center; align-items: center; }
.badge-text { font-size: 48px; font-weight: bold; color: #111111; }
.english { width: 264px; height: 20px; font-size: 15px; font-weight: bold; color: #111111; }
.instruction { width: 264px; height: 29px; font-size: 24px; font-weight: bold; color: #111111; }
.underline { width: 264px; height: 15px; background-color: #FF2E78; }
</style>
