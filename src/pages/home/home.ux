  width: 192px;
  height: 490px;
  background-color: #f3efe7;
}
.abs {
  position: absolute;
}
.title {
  width: 192px;
  height: 56px;
  font-size: 50px;
  font-weight: 900;
  color: #111111;
  text-align: center;
}
.title-shadow {
  color: #ffd323;
}
.block {
  width: 118px;
  height: 54px;
  background-color: #ffd323;
  border: 3px solid #111111;
  justify-content: center;
  align-items: center;
}
.block-txt {
  font-size: 34px;
  font-weight: 900;
  color: #111111;
}
.card-shadow {
  width: 112px;
  height: 50px;
  background-color: #ff5b8d;
}
.card {
  width: 112px;
  height: 50px;
  background-color: #ffffff;
  border: 3px solid #111111;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.card-txt {
  font-size: 13px;
  font-weight: 900;
  color: #66615b;
  text-align: center;
}
.container {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
}
/* 内容保留 192×490 坐标；外层负责满屏背景和裁切。 */
.design-stage {
  position: absolute;
  left: 0px;
  top: 0px;
  width: 192px;
  height: 490px;
}
/* Band 10：212×520，DPR=2；按高度等比适配，避免按宽度放大后超高。 */
@media (width: 106) and (height: 260) {
  .design-stage {
    left: 3.733539px;
    transform: scale(0.96110897);
    transform-origin: 0px 0px;
  }
}
